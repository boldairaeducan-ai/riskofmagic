<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../Styles/Menus.uss" />
    <ui:VisualElement name="row" class="option-row">
        <ui:Label name="label" text="Option" class="option-row__label" />
        <ui:VisualElement class="option-row__control">
            <ui:Button name="previous" text="‹" class="option-arrow" />
            <ui:Label name="value" text="Valeur" class="option-row__value" />
            <ui:Button name="next" text="›" class="option-arrow" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
